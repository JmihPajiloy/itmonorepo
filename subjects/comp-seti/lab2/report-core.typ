    #set par(justify: false, first-line-indent: 0pt, spacing: 0pt)
    *Кадр 11:* ID 0x8b13; MF=1; Offset=0
    #v(4pt)
    #packet-band((
      [IPv4\ 20 байт],
      [ICMP 8 байт + данные 1472 байта\ Нагрузка фрагмента: 1480 байт],
