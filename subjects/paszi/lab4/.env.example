# Учебная конфигурация. make env создаёт .env со случайными секретами.
DATABASE_URL=postgresql+psycopg://lab4:replace-with-random-password@db:5432/lab4
POSTGRES_DB=lab4
POSTGRES_USER=lab4
POSTGRES_PASSWORD=replace-with-random-password
HASH_SCHEME=argon2id
SECRET_KEY=replace-with-a-random-key-at-least-32-characters
APP_ENV=development
PORT=8000
FRONTEND_PORT=8084
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
TOKEN_TTL_MINUTES=30
